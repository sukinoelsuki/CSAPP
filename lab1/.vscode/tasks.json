{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Make: Build Project", 
            "command": "make",
            "args": [], 
            "options": {
                "cwd": "${workspaceFolder}" 
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true 
            },
            "detail": "编译并包含调试信息"
        },
        {
            "type": "shell",
            "label": "Make: Clean",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        // ------------------ 这是为你新增加的对齐任务 ------------------
        {
            "type": "shell",
            "label": "Make: Run Exe",
            // 这里替换为你 Makefile 最终生成的实际 exe 相对路径
            "command": ".\\build\\lab1_main.exe", 
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // 核心魔法：执行此任务前，必须先成功执行 "Make: Build Project"
            "dependsOn": "Make: Build Project",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,      // 自动聚焦终端，方便你输入测试数据
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true       // 每次运行前自动清空终端，保持清爽
            },
            "detail": "自动编译并运行最终生成的程序"
        }
    ]
}